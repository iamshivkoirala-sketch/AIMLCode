<div class="container mt-4">

    <h2>Paste Resume</h2>

    <form method="post" action="SubmitResume">

        <div class="mb-3">
            <label class="form-label">
                Paste Resume Content
            </label>

            <textarea name="resume"
                      class="form-control"
                      rows="20"
                      >
            </textarea>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Submit
        </button>

        <button type="reset"
                class="btn btn-secondary">
            Cancel
        </button>

    </form>

</div>